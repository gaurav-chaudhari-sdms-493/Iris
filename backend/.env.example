# Project Iris - Environment Variables Template (.env.example)

# System Hardware Mode
IRIS_HARDWARE_MOCK=true
IRIS_SIMULATED=true

# Tuya Cloud API Credentials
TUYA_API_KEY=your_tuya_api_key_here
TUYA_API_SECRET=your_tuya_api_secret_here
TUYA_PROJECT_CODE=your_tuya_project_code_here
TUYA_API_REGION=in

# AZIOT 4 Node Smart Switch - Relay Module A
RELAY_A_ID=your_relay_a_device_id_here
RELAY_A_KEY=your_relay_a_local_key_here
RELAY_A_IP=192.168.1.50
RELAY_A_VERSION=3.3

# AZIOT Smart Switch - Relay Module B (Future expansion)
RELAY_B_ID=your_relay_b_device_id_here
RELAY_B_KEY=your_relay_b_local_key_here
RELAY_B_IP=192.168.1.51
RELAY_B_VERSION=3.3

# Broadlink RM4 Mini Infrared Blaster
BROADLINK_IP=192.168.1.60
BROADLINK_MAC=A4:91:B1:00:00:00

# RTSP Video Stream
IRIS_RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
IRIS_VIDEO_PATH=data/office/VIDEO-2026-07-28-15-36-24.mp4
IRIS_YOLO_MODEL=models/best.pt

# Head detection confidence gate (lower = catches more distant/overhead heads)
IRIS_YOLO_CONF=0.50

# Force inference device (cpu / cuda:0). Leave unset for auto-detect.
# IRIS_YOLO_DEVICE=cpu

# --- False-vacancy protection -------------------------------------------------
# Consecutive zero-headcount polls required before the vacancy timer starts.
IRIS_ZERO_CONFIRM_POLLS=3

# Suppress vacancy auto-off while motion was seen this recently (seconds).
# Motion has no notion of pose, so it still sees an occupant the detectors lost.
# 0 disables the veto.
IRIS_VACANCY_MOTION_VETO=10

# Seconds of confirmed vacancy before the light bulbs switch off.
IRIS_LB_AUTO_OFF=20
